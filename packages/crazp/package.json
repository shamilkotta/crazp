{
  "name": "crazp",
  "description": "Filesystem first Cloudflare agent framework",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "modules.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clear",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
