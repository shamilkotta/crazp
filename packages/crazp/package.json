{
  "name": "crazp",
  "description": "Filesystem first agent framework",
  "version": "0.0.2",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/shamilkotta/crazp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shamilkotta/crazp.git",
    "directory": "packages/crazp"
  },
  "bugs": {
    "url": "https://github.com/shamilkotta/crazp/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "framework",
    "filesystem first"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./channels": {
      "types": "./dist/channels/index.d.ts",
      "import": "./dist/channels/index.js"
    },
    "./modules": {
      "types": "./modules.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "modules.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clear",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "ai": "^7.0.0",
    "@cloudflare/think": "^0.16.0"
  },
  "peerDependencies": {
    "@chat-adapter/discord": "^4.31.0",
    "@chat-adapter/gchat": "^4.31.0",
    "@chat-adapter/github": "^4.31.0",
    "@chat-adapter/linear": "^4.31.0",
    "@chat-adapter/slack": "^4.31.0",
    "@chat-adapter/teams": "^4.31.0",
    "@chat-adapter/telegram": "^4.31.0",
    "@chat-adapter/twilio": "^4.31.0",
    "@chat-adapter/whatsapp": "^4.31.0",
    "@chat-adapter/x": "^4.31.0"
  },
  "peerDependenciesMeta": {
    "@chat-adapter/discord": {
      "optional": true
    },
    "@chat-adapter/gchat": {
      "optional": true
    },
    "@chat-adapter/github": {
      "optional": true
    },
    "@chat-adapter/linear": {
      "optional": true
    },
    "@chat-adapter/slack": {
      "optional": true
    },
    "@chat-adapter/teams": {
      "optional": true
    },
    "@chat-adapter/telegram": {
      "optional": true
    },
    "@chat-adapter/twilio": {
      "optional": true
    },
    "@chat-adapter/whatsapp": {
      "optional": true
    },
    "@chat-adapter/x": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chat-adapter/discord": "^4.39.0",
    "@chat-adapter/gchat": "^4.39.0",
    "@chat-adapter/github": "^4.39.0",
    "@chat-adapter/linear": "^4.39.0",
    "@chat-adapter/slack": "^4.39.0",
    "@chat-adapter/teams": "^4.39.0",
    "@chat-adapter/telegram": "^4.39.0",
    "@chat-adapter/twilio": "^4.39.0",
    "@chat-adapter/whatsapp": "^4.39.0",
    "@chat-adapter/x": "^4.39.0",
    "@cloudflare/workers-types": "^5.20260810.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
